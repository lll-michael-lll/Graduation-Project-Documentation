%%{init: {
  "theme": "base",
  "themeVariables": {
    "primaryColor": "#6D94C5",
    "primaryTextColor": "#1a1a1a",
    "primaryBorderColor": "#810B38",
    "lineColor": "#810B38",
    "fontFamily": "Liberation Sans, Arial, sans-serif",
    "fontSize": "13px"
  }
}}%%
flowchart TB
    classDef api     fill:#A5E9DD,stroke:#810B38,color:#1a1a1a
    classDef auth    fill:#CBDCEB,stroke:#810B38,color:#1a1a1a
    classDef policy  fill:#6D94C5,stroke:#810B38,color:#fff
    classDef proxy   fill:#4BB8FA,stroke:#810B38,color:#1a1a1a
    classDef pipe    fill:#5DF8D8,stroke:#810B38,color:#1a1a1a
    classDef sidecar fill:#FDF4AF,stroke:#810B38,color:#1a1a1a
    classDef store   fill:#F0FFDF,stroke:#810B38,color:#1a1a1a
    classDef db      fill:#CBDCEB,stroke:#810B38,color:#1a1a1a

    REQ["Incoming Client\n(CLI mTLS / WebUI REST)"]

    subgraph API_LAYER ["API Layer"]
        REST["REST API Server\n/api/admin/*  /api/user/*  /api/auth/*"]:::api
    end

    subgraph AUTH_LAYER ["Authentication and Identity"]
        OIDC["OIDC Token Validation\n(Keycloak)"]:::auth
        JWT["JWT Issue/Verify\nHS256, JTI revocation\nDevice fingerprint binding"]:::auth
        TOTP["TOTP 2FA\n(admin only)"]:::auth
        PKI["Built-in PKI\nInternal CA, CSR signing\nmTLS cert lifecycle"]:::auth
        ALTCHA["ALTCHA PoW\nSHA-256 anti-bot"]:::auth
    end

    subgraph POLICY_LAYER ["Policy Engine"]
        RBAC["RBAC Resolver\n(super / db_admin / policy_admin / auditor)"]:::policy
        SAFETY["Safety Templates\nallow, deny, warn, mask"]:::policy
        COMPLIANCE["Compliance Templates\nGDPR, HIPAA, PCI-DSS, SOX, ISO27001, NIST"]:::policy
    end

    subgraph PROXY_LAYER ["Proxy / Dispatcher"]
        DISP2["6-Phase Dispatcher\nPeek, StartSession, Bind\nDial, Handshake, Loop"]:::proxy
        CRED["Credential Mode\nephemeral, shared pool, ticket, mTLS"]:::proxy
    end

    subgraph PIPE_LAYER ["Interceptor Pipeline (per query)"]
        P_RL["1 RateLimit"]:::pipe
        P_OT["2 Telemetry (OTel span)"]:::pipe
        P_LOG["3 Logging (NDJSON)"]:::pipe
        P_AN["4 Anomaly (ML Ensemble)"]:::pipe
        P_SQ["5 SafeQuery (T-SQL AST)"]:::pipe
        P_RM["6 RowMask"]:::pipe
        P_CM["7 ColMask (policy)"]:::pipe
        P_AI["8 AIMask (LLM)"]:::pipe
    end

    STORE["MySQL Store\nConfig, Accounts, Sessions, Audit"]:::store

    subgraph SIDECARS2 ["Sidecars"]
        TSQL3["zGate-Tsql-Parser\ngRPC AST"]:::sidecar
        AI3["zGate-AI\ngRPC LLM"]:::sidecar
    end

    DB_OUT["Backend DBs\nMySQL :9000  PG :9001  MSSQL :9002"]:::db

    REQ --> REST
    REST --> OIDC
    REST --> JWT
    REST --> TOTP
    REST --> ALTCHA
    JWT --> RBAC
    OIDC --> JWT
    RBAC --> SAFETY
    RBAC --> COMPLIANCE
    SAFETY --> PKI
    PKI --> CRED
    RBAC --> DISP2
    DISP2 --> CRED
    DISP2 --> P_RL --> P_OT --> P_LOG --> P_AN --> P_SQ --> P_RM --> P_CM --> P_AI
    P_SQ <-->|"gRPC"| TSQL3
    P_AI <-->|"gRPC"| AI3
    P_RL --> STORE
    P_LOG --> STORE
    P_AN --> STORE
    P_AI --> DB_OUT
    CRED --> DB_OUT
