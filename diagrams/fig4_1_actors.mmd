flowchart LR
    classDef human    fill:#FFD8DF,stroke:#6D94C5,color:#1a1a1a
    classDef system   fill:#6D94C5,stroke:#CBDCEB,color:#fff
    classDef external fill:#CBDCEB,stroke:#6D94C5,color:#1a1a1a
    classDef sidecar  fill:#F0FFDF,stroke:#6D94C5,color:#1a1a1a
    classDef client   fill:#A8DF8E,stroke:#6D94C5,color:#1a1a1a
    classDef deploy   fill:#E8DFCA,stroke:#6D94C5,color:#1a1a1a

    EU["End User / Developer"]:::human
    SA["System Administrator\n(db_admin | policy_admin | auditor)"]:::human
    SUPER["Super Administrator"]:::human

    subgraph SYS ["zGate Platform"]
        CLI["zGate-CLI\nOIDC Device Flow · mTLS · BubbleTea TUI"]:::client
        WEBUI["zGate-WebUI\nNext.js 15 · iron-session · PKCE"]:::client
        GW["zGate-Server\nGateway · Policy Engine · Auth · PKI"]:::system
        AI["zGate-AI\ngRPC LLM Masking Engine"]:::sidecar
        TSQL["zGate-Tsql-Parser\ngRPC AST Analyzer"]:::sidecar
        DEPLOY["zGate-Deploy\nDocker Compose · Vault · OTel"]:::deploy
    end

    DB1["MySQL :9000"]:::external
    DB2["PostgreSQL :9001"]:::external
    DB3["MSSQL/TDS :9002"]:::external
    KC["Keycloak\nOIDC Provider"]:::external

    EU --> CLI
    SA --> WEBUI
    SUPER --> WEBUI
    CLI -->|"OIDC Device Flow"| KC
    WEBUI -->|"PKCE/OIDC"| KC
    KC -->|"ID token"| GW
    CLI -->|"REST API + mTLS tunnel"| GW
    WEBUI -->|"REST API (iron-session proxy)"| GW
    GW --> DB1
    GW --> DB2
    GW --> DB3
    GW <-->|"gRPC AST"| TSQL
    GW <-->|"gRPC LLM"| AI
    DEPLOY -->|"provisions"| GW
