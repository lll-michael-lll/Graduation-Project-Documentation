%%{init: {
  "theme": "base",
  "themeVariables": {
    "primaryColor": "#6D94C5",
    "primaryTextColor": "#1a1a1a",
    "primaryBorderColor": "#4a6fa0",
    "lineColor": "#4a6fa0",
    "fontFamily": "Liberation Sans, Arial, sans-serif",
    "fontSize": "13px"
  }
}}%%
flowchart LR
    classDef human   fill:#FFD8DF,stroke:#c0626e,color:#1a1a1a
    classDef super   fill:#FFAAB8,stroke:#c0626e,color:#1a1a1a
    classDef server  fill:#6D94C5,stroke:#4a6fa0,color:#fff
    classDef sidecar fill:#F5EFE6,stroke:#4a6fa0,color:#1a1a1a
    classDef db      fill:#CBDCEB,stroke:#4a6fa0,color:#1a1a1a
    classDef ext     fill:#E8DFCA,stroke:#4a6fa0,color:#1a1a1a

    EU(["End User"]):::human
    SYS(["System Admin"]):::human
    SUP(["Super Admin"]):::super

    subgraph GW ["zGate Gateway System"]
        CLI_UC["CLI Use Cases\nLogin (OIDC Device)\nList DBs\nConnect (mTLS tunnel)\nToken Refresh\nLogout"]:::server
        WEB_UC["WebUI Use Cases\nDB Config (5 TLS modes)\nUser + Role Mgmt\nPolicy Templates\nSession Monitor + Kill\nAudit Logs\nShared Pools\nCompliance Templates\nWarn Queue Review\nAI/LLM Config"]:::server
        SRV_UC["Server Use Cases\nAuth (JWT HS256)\nRBAC Enforcement\nInterceptor Pipeline\nEphemeral Credentials\nPKI / mTLS Issuance\nAudit Logging (NDJSON)\nAnomaly Detection"]:::server
    end

    subgraph SIDECARS ["Supporting Services"]
        TSQL_UC["T-SQL Parser\ngRPC AST Analysis\n40+ SQL features"]:::sidecar
        AI_UC["AI Engine\ngRPC LLM Column Masking\nHot-swap providers"]:::sidecar
        KC_UC["Keycloak\nOIDC Device Flow\nPKCE Browser Flow"]:::ext
    end

    DB["MySQL · PostgreSQL · MSSQL"]:::db

    EU -->|"CLI"| CLI_UC
    SYS -->|"WebUI"| WEB_UC
    SUP -->|"WebUI (super)"| WEB_UC
    CLI_UC --> SRV_UC
    WEB_UC --> SRV_UC
    SRV_UC --> DB
    SRV_UC <--> TSQL_UC
    SRV_UC <--> AI_UC
    EU --> KC_UC
    SYS --> KC_UC
    KC_UC --> SRV_UC
